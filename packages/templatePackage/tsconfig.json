{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "rootDir": "src",
        "outDir": "lib",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "types": ["node", "jest"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "lib"]
}